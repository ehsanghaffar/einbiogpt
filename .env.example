# ============================================
# LLM Model Selection
# ============================================
# Choose one of: gpt-4o (default), gpt-5, gemini-2.0-flash, gemini-2.5-flash, gemini-3.7-flash
# or any OpenRouter model slug
# See docs/LLM_MODEL_CONFIGURATION.md for details
NEXT_LLM_MODEL=gpt-4o

# ============================================
# OpenAI Configuration
# ============================================
# Required for: gpt-4o, gpt-5
# Get from: https://platform.openai.com/api-keys
# NOTE: Server-side only, NOT prefixed with NEXT_PUBLIC_
NEXT_OPENAI_API_KEY=sk_live_your_key_here

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=BioGPT
NEXT_LLM_PROVIDER=

# ============================================
# Gemini Configuration (for Google Gemini models)
# ============================================
# Required for: gemini-2.0-flash, gemini-2.5-flash, gemini-3.7-flash
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# ============================================
# Rate Limiting
# ============================================
# Upstash Redis for production rate limiting (optional - falls back to in-memory if not set)
REDIS_URL=
REDIS_TOKEN=

# Rate limiting window (milliseconds)
RATE_LIMIT_WINDOW=60000

# Maximum requests per window per IP
RATE_LIMIT_MAX=10

# ============================================
# Client-side Settings
# ============================================
# Cooldown between requests (seconds)
NEXT_PUBLIC_COOLDOWN_TIME=10

# ============================================
# Quick Start
# ============================================
# 1. Using GPT-4o (requires OpenAI key):
#    NEXT_LLM_MODEL=gpt-4o
#    NEXT_OPENAI_API_KEY=sk_...
#
# 2. Using OpenRouter models (requires OpenRouter key):
#    NEXT_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#    OPENROUTER_API_KEY=...
#
# 3. Using Gemini models (requires Google AI Studio key):
#    NEXT_LLM_MODEL=gemini-2.0-flash
#    GEMINI_API_KEY=...
#
# For detailed setup, see docs/ENV_VARIABLES.md